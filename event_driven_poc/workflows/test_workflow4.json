{
  "name": "test_workflow4",
  "description": "Event-driven pipeline with direct Conductor-microservice integration",
  "version": 2,
  "tasks": [
    {
      "name": "phone_validation",
      "taskReferenceName": "phone_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "phone-validation-requests",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "taskId": "phone_validation_task",
            "eventType": "phone_validation_request",
            "data": {
              "input_bucket": "raw-data",
              "input_key": "customer_data_sample.csv",
              "output_bucket": "phone-validated",
              "output_key": "phone_validation_${workflow.workflowId}.csv",
              "pipelineStage": "phone_validation",
              "records": 1000
            }
          },
          "key": "phone-validation-${workflow.workflowId}"
        }
      }
    },
    {
      "name": "wait_for_phone_validation_completion",
      "taskReferenceName": "wait_for_phone_validation_completion",
      "type": "EVENT",
      "sink": "conductor:phone_validation_completed",
      "asyncComplete": true
    },
    {
      "name": "enrichment",
      "taskReferenceName": "enrichment",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "enrichment-requests",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "taskId": "enrichment_task",
            "eventType": "enrichment_request",
            "data": {
              "input_bucket": "phone-validated",
              "input_key": "phone_validation_${workflow.workflowId}.csv",
              "output_bucket": "enriched",
              "output_key": "enrichment_${workflow.workflowId}.csv",
              "pipelineStage": "enrichment",
              "previousStage": "phone_validation",
              "records": 1000
            }
          },
          "key": "enrichment-${workflow.workflowId}"
        }
      }
    },
    {
      "name": "wait_for_enrichment_completion",
      "taskReferenceName": "wait_for_enrichment_completion",
      "type": "EVENT",
      "sink": "conductor:enrichment_completed",
      "asyncComplete": true
    },
    {
      "name": "email_validation",
      "taskReferenceName": "email_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "email-validation-requests",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "taskId": "email_validation_task",
            "eventType": "email_validation_request",
            "data": {
              "input_bucket": "enriched",
              "input_key": "enrichment_${workflow.workflowId}.csv",
              "output_bucket": "email-validated",
              "output_key": "email_validation_${workflow.workflowId}.csv",
              "pipelineStage": "email_validation",
              "previousStage": "enrichment",
              "records": 1000
            }
          },
          "key": "email-validation-${workflow.workflowId}"
        }
      }
    },
    {
      "name": "wait_for_email_validation_completion",
      "taskReferenceName": "wait_for_email_validation_completion",
      "type": "EVENT",
      "sink": "conductor:email_validation_completed",
      "asyncComplete": true
    },
    {
      "name": "finalize_pipeline",
      "taskReferenceName": "finalize_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": {
            "workflowId": "${workflow.workflowId}",
            "eventType": "pipeline_completed",
            "data": {
              "final_bucket": "email-validated",
              "final_key": "email_validation_${workflow.workflowId}.csv",
              "pipelineStage": "completed",
              "records": 1000
            }
          },
          "key": "pipeline-complete-${workflow.workflowId}"
        }
      }
    }
  ],
  "inputParameters": [],
  "outputParameters": {
    "pipeline_result": "email_validation_${workflow.workflowId}.csv",
    "workflow_id": "${workflow.workflowId}",
    "workflowId": "${workflow.workflowId}",
    "final_file": "enriched_${workflow.instanceId}.csv",
    "phone_result": "${wait_for_phone_validation_completion.output}",
    "enrichment_result": "${wait_for_enrichment_completion.output}",
    "email_result": "${wait_for_email_validation_completion.output}"
  },
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 3600,
  "ownerEmail": "team@data-axle.com"
}