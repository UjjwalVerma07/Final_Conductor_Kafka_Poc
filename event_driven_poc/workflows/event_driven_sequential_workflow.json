{
  "name": "event_driven_sequential_workflow",
  "description": "Event-driven sequential pipeline: Airflow → Email Validation → Phone Validation → Enricher",
  "version": 5,
  "tasks": [
    {
      "name": "trigger_airflow_dag",
      "taskReferenceName": "trigger_airflow_dag",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"airflow_trigger_requested\", \"data\": {\"dag_id\": \"nua-nameparse-process-stage-v02-00-06-tiny\", \"execution_id\": \"WBNameParse\", \"pipelineStage\": \"airflow_processing\"}}",
          "key": "airflow-trigger-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_airflow_completion",
      "taskReferenceName": "wait_for_airflow_completion",
      "type": "EVENT",
      "sink": "conductor:airflow_dag_completed",
      "asyncComplete": true
    },
    {
      "name": "trigger_email_validation",
      "taskReferenceName": "trigger_email_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"pipeline_started\", \"data\": {\"input_bucket\": \"raw-data\", \"input_key\": \"customer_data_sample.csv\", \"output_bucket\": \"email-validated\", \"output_key\": \"email_validated_${workflow.instanceId}.csv\", \"pipelineStage\": \"email_validation\", \"records\": 1000}}",
          "key": "email-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_email_completion",
      "taskReferenceName": "wait_for_email_completion",
      "type": "EVENT",
      "sink": "conductor:email_validation_completed",
      "asyncComplete": true
    },
    {
      "name": "trigger_phone_validation",
      "taskReferenceName": "trigger_phone_validation",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"phone_validation_requested\", \"data\": {\"input_bucket\": \"email-validated\", \"input_key\": \"email_validated_${workflow.instanceId}.csv\", \"output_bucket\": \"phone-validated\", \"output_key\": \"phone_validated_${workflow.instanceId}.csv\", \"pipelineStage\": \"phone_validation\", \"previousStage\": \"email_validation\"}}",
          "key": "phone-validation-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_phone_completion",
      "taskReferenceName": "wait_for_phone_completion",
      "type": "EVENT",
      "sink": "conductor:phone_validation_completed",
      "asyncComplete": true
    },
    {
      "name": "trigger_enrichment",
      "taskReferenceName": "trigger_enrichment",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"enrichment_requested\", \"data\": {\"input_bucket\": \"phone-validated\", \"input_key\": \"phone_validated_${workflow.instanceId}.csv\", \"output_bucket\": \"enriched\", \"output_key\": \"enriched_${workflow.instanceId}.csv\", \"pipelineStage\": \"enrichment\", \"previousStage\": \"phone_validation\"}}",
          "key": "enrichment-${workflow.instanceId}"
        }
      }
    },
    {
      "name": "wait_for_enrichment_completion",
      "taskReferenceName": "wait_for_enrichment_completion",
      "type": "EVENT",
      "sink": "conductor:enrichment_completed",
      "asyncComplete": true
    },
    {
      "name": "finalize_pipeline",
      "taskReferenceName": "finalize_pipeline",
      "type": "KAFKA_PUBLISH",
      "inputParameters": {
        "kafka_request": {
          "topic": "conductor-events",
          "bootStrapServers": "kafka:9092",
          "value": "{\"workflowId\": \"${workflow.workflowId}\", \"eventType\": \"pipeline_completed\", \"data\": {\"final_bucket\": \"enriched\", \"final_key\": \"enriched_${workflow.instanceId}.csv\", \"pipelineStage\": \"completed\", \"records\": 1000}}",
          "key": "pipeline-complete-${workflow.instanceId}"
        }
      }
    }
  ],
  "inputParameters": [],
  "outputParameters": {
    "pipeline_result": "${finalize_pipeline.output}",
    "workflow_id": "${workflow.workflowId}",
    "airflow_result": "${wait_for_airflow_completion.output}",
    "email_result": "${wait_for_email_completion.output}",
    "phone_result": "${wait_for_phone_completion.output}",
    "enrichment_result": "${wait_for_enrichment_completion.output}",
    "final_file": "enriched_${workflow.instanceId}.csv"
  },
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 3600
}
